{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ceptecukka.local/schemas/research-pack.json",
  "title": "CeptecukkaResearchPack",
  "type": "object",
  "additionalProperties": false,
  "required": ["candidate_id", "chronology", "people", "claims", "angle", "spine", "visuals_needed", "sources", "gaps", "trust_score", "decision"],
  "properties": {
    "candidate_id": { "type": "string" },
    "chronology": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["when", "what", "source_url"],
        "properties": {
          "when": { "type": "string" },
          "what": { "type": "string" },
          "source_url": { "type": "string" }
        }
      }
    },
    "people": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "who"],
        "properties": {
          "name": { "type": "string" },
          "who": { "type": "string" }
        }
      }
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["text", "label"],
        "properties": {
          "text": { "type": "string" },
          "label": {
            "enum": [
              "DOGRULANDI",
              "KISMEN_DOGRULANDI",
              "TARTISMALI",
              "KAYNAKSIZ_EFSANE",
              "YANLIS_BAGLAM",
              "KULLANMA"
            ]
          },
          "notes": { "type": "string" }
        }
      }
    },
    "angle": { "type": "string" },
    "spine": { "type": "string" },
    "visuals_needed": { "type": "array", "items": { "type": "string" } },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["url", "title", "tier"],
        "properties": {
          "url": { "type": "string" },
          "title": { "type": "string" },
          "tier": { "type": "integer", "minimum": 1, "maximum": 4 }
        }
      }
    },
    "gaps": { "type": "array", "items": { "type": "string" } },
    "trust_score": { "type": "integer", "minimum": 0, "maximum": 100 },
    "decision": { "enum": ["continue", "needs_research", "killed"] }
  }
}
